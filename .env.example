# Placeholders. No pegar secretos. El PAT real vive solo en .env (gitignored).
# El nombre de la variable que ya guarda el PAT. No copiar el valor aquí.
AZDO_WI_PAT_VAR=TOKEN-AZURE

QA_INSTALL_DEPS=true
AZDO_WI_ORG=aviancavsts
AZDO_WI_PROJECT=Integration
AZDO_WI_ENABLED=true
AZDO_WI_INCLUDE_ATTACHMENTS=true
AZDO_WI_MAX_ATTACHMENT_MB=25
AZDO_WI_MAX_TOTAL_ATTACHMENTS_MB=100
AZDO_WI_MAX_RELATED_DEPTH=1
AZDO_WI_MAX_COMMENTS=200
AZDO_WI_MAX_EXTRACT_CHARS=20000
AZDO_WI_LLM_ENABLED=false
AZDO_WI_KEEP_RAW=false
